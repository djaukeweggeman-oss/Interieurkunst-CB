# Publieke site-URL. Gebruik lokaal http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase projectinstellingen. Deel de service-role key nooit met de browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gebruik uitsluitend een Mollie test_* sleutel tijdens ontwikkeling.
MOLLIE_API_KEY=

# Transactionele e-mail (provider nog te kiezen).
EMAIL_FROM=
RESEND_API_KEY=

# Optionele extra antispambescherming.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

